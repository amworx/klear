<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: brand-cyan only. The animated splash mark
         is the Lottie shown by KlearSplashPage (assets/lottie/splash.json), so
         we set the system animated icon to transparent — otherwise Android 12+
         defaults to the launcher icon (white squircle) and hides the Lottie. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/klear_launch_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
</resources>