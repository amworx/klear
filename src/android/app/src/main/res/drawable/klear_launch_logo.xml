<?xml version="1.0" encoding="utf-8"?>
<!-- Klear launch mark v3 (Ripple): a white badge circle holding the cyan
     brand drop, matching the Flutter Ripple splash's center mark so the
     Android 12+ cold-start hands over seamlessly. Rendered on brand-cyan
     background (klear_launch_bg). The cyan drop is scaled 0.62 about the
     viewBox center so it sits inside the white circle. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- White badge circle -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M2.5,12a9.5,9.5 0 1,0 19,0a9.5,9.5 0 1,0 -19,0Z" />
    <!-- Cyan brand drop (scaled 0.62 about center 12,12) + specular glint -->
    <group
        android:scaleX="0.62"
        android:scaleY="0.62"
        android:pivotX="12"
        android:pivotY="12">
        <path
            android:fillColor="#FF0E7490"
            android:pathData="M12,1.44C12,1.44 21.12,10.56 21.12,14.88C21.12,19.2 17.4,22.56 12,22.56C6.6,22.56 2.88,19.2 2.88,14.88C2.88,10.56 12,1.44 12,1.44Z" />
        <path
            android:fillColor="#D9FFFFFF"
            android:pathData="M8.6,12.9A1.5,1.5 0 1,0 11.6,12.9A1.5,1.5 0 1,0 8.6,12.9Z" />
    </group>
</vector>
