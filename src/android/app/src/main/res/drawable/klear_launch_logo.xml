<?xml version="1.0" encoding="utf-8"?>
<!-- Klear launch mark v2: solid cyan drop sized to fill the Android 12+
     splash container so it renders COMPLETELY (stroke/outline icons get
     clipped by the OS). Matches the Flutter animated drop shape (same
     normalized control points) and its solid first frame, so the system
     splash hands over seamlessly to the filling drop. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Cyan water drop (brand primary #0E7490), tip up, fills the canvas -->
    <path
        android:fillColor="#FF0E7490"
        android:pathData="M12,1.44C12,1.44 21.12,10.56 21.12,14.88C21.12,19.2 17.4,22.56 12,22.56C6.6,22.56 2.88,19.2 2.88,14.88C2.88,10.56 12,1.44 12,1.44Z" />
    <!-- Specular highlight: small white glint in the upper-left of the bulb -->
    <path
        android:fillColor="#D9FFFFFF"
        android:pathData="M8.6,12.9A1.5,1.5 0 1,0 11.6,12.9A1.5,1.5 0 1,0 8.6,12.9Z" />
    <!-- Tiny bubble near the lower-right (mirrors the loader's rising bubbles) -->
    <path
        android:fillColor="#B3FFFFFF"
        android:pathData="M13.4,18.4A1.0,1.0 0 1,0 15.4,18.4A1.0,1.0 0 1,0 13.4,18.4Z" />
</vector>